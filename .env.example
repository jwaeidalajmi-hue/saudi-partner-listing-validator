# Copy to .env and fill in.

# "anthropic" runs the real check with Claude vision; "mock" needs no key
# (photo contents are guessed from file names, for demos only).
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limits
MAX_PHOTOS=20
MAX_UPLOAD_MB=15
VISION_CONCURRENCY=4
